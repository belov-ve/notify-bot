instances:
  - name: "telegram_bot"
    port: 8041
    enabled: true
    show_time: true
    ttl: 3600
    block_delivery: false # Временная блокировка отправки (сообщения копятся в очереди)
    allowed_ips:
      - "192.168.1.0/24"
    telegram:
      enabled: true
      bot_token: "123456:ABC-DEF"
      chat_id: "-456789123"
      menu: "camera_menu" # ID подключенного меню для Telegram
      retry_count: 3   # Количество попыток внутри одного цикла воркера (default: 3)
      retry_delay: 2   # Задержка между попытками в секундах (default: 2)



  - name: "matrix_bot"
    port: 8042
    enabled: true
    show_time: true
    ttl: 86400
    block_delivery: false   # Временная блокировка отправки (true - сообщения копятся в очереди).
    allowed_ips:
      - "0.0.0.0/0"
    matrix:
      enabled: true
      homeserver: "https://matrix.example.com"
      username: "@notify-bot:example.com"
      password: "your_strong_password"   # или access_token
      room_id: "!roomid:example.com"
      retry_count: 3
      retry_delay: 2


  - name: "default"
    enabled: false      # default
    show_time: false    # default
    port: 8050
    ttl: 0              # default: Время жизни сообщения в очереди (сек). По умолчанию 0 (одна попытка).
    block_delivery: false   # default: Временная блокировка отправки (true - сообщения копятся в очереди).
    tasks: "system_tasks" # ID подключенного списка задач по расписанию
    allowed_ips:        # "0.0.0.0/0" по умолчанию, если не задано
      - "0.0.0.0/0"
      - "192.168.65.1"
      - "172.17.0.1/32"
      - "10.0.0.0/8"
    telegram:
      enabled: true
      bot_token: "789101:GHI-JKL"
      chat_id: "-987654321"
      menu: "menu-<id>"
      retry_count: 3    # default
      retry_delay: 2    # default
    matrix:
      enabled: true
      homeserver: "https://matrix.example.com"
      username: "@notify-bot:example.com"
      password: "secret_password"  # или access_token
      # access_token: "syt_..."    # токен вместо пароля
      encryption: false            # default false
      recovery_key: "XXXXXX"       # требуется если "encryption: true"
      room_id: "!roomid:example.com"
      menu: "menu-<id>"
      retry_count: 3    # default
      retry_delay: 2    # default

# Глобальная секция меню для интерактивных команд
menus:
  - id: "camera_menu"
    items:
      - name: "snapshot/hd"
        url: "http://localhost:8090/snapshot/hd?send=true"
        description: "Получить HD изображение с камеры"
        reaction: "📸"
      - name: "snapshot/sd"
        url: "http://localhost:8090/snapshot/sd?send=true"
        description: "Получить SD изображение"
        reaction: "📷"
      - name: "status"
        script: "stats.sh"
        description: "Посмотреть статистику очередей"
        reaction: "📊"

# Глобальная секция задач по расписанию (cron)
tasks:
  - id: "system_tasks"
    items:
      - name: "disk_check"
        enabled: false           # Включение/отключение задачи (по умолчанию true)
        schedule: "*/5 * * * *"  # Выполнять каждые 5 минут
        script: "example_report.sh"
        description: "Проверка свободного места на диске"
      - name: "pdf_report"
        schedule: "0 18 * * *"   # Выполнять каждый день в 18:00
        script: "example_pdf_report.sh"
        description: "Генерация системного PDF-отчета"
      - name: "weather_workdays"
        schedule: "15 7 * * 1-5"  # По рабочим дням (Пн-Пт) в 7:15
        script: "weather.sh"      # Локальный скрипт прогноза погоды
        description: "Прогноз погоды по будням"
      - name: "weather_weekends"
        schedule: "0 9 * * 0,6"   # По выходным дням (Сб-Вс) в 9:00
        script: "weather.sh"      # Локальный скрипт прогноза погоды
        description: "Прогноз погоды по выходным"
